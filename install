#!/bin/bash
clear

# ============================================================================
# OS / VERSION CHECK (Ubuntu 20.04, 22.04, 24.04)
# ============================================================================
check_os () {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        OS_ID="$ID"
        OS_VER="$VERSION_ID"
    else
        OS_ID="unknown"
        OS_VER="unknown"
    fi

    if [ "$OS_ID" != "ubuntu" ]; then
        echo -e "\033[1;31m[!] This script is intended for Ubuntu. Detected: $OS_ID $OS_VER\033[0m"
        echo -e "\033[1;33m[!] Continuing anyway, but things may not work as expected.\033[0m"
        sleep 2
        return
    fi

    case "$OS_VER" in
        20.04|22.04|24.04)
            echo -e "\033[1;32m[✓] Ubuntu $OS_VER detected - supported.\033[0m"
            ;;
        *)
            echo -e "\033[1;33m[!] Ubuntu $OS_VER detected - not explicitly tested (supported: 20.04, 22.04, 24.04).\033[0m"
            echo -e "\033[1;33m[!] Continuing anyway.\033[0m"
            sleep 2
            ;;
    esac
}

fun_bar () {
comando[0]="$1"
comando[1]="$2"
 (
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
 ) > /dev/null 2>&1 &
 tput civis
echo -ne "  \033[1;33mWAIT \033[1;37m- \033[1;33m["
while true; do
   for((i=0; i<18; i++)); do
   echo -ne "\033[1;31m#"
   sleep 0.1s
   done
   [[ -e $HOME/fim ]] && rm $HOME/fim && break
   echo -e "\033[1;33m]"
   sleep 1s
   tput cuu1
   tput dl1
   echo -ne "  \033[1;33mWAIT \033[1;37m- \033[1;33m["
done
echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
tput cnorm
}

# ============================================================================
# NON-INTERACTIVE APT (avoids prompts on newer Ubuntu releases)
# ============================================================================
export DEBIAN_FRONTEND=noninteractive

check_os

clear
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "SLOWDNS MANAGER INSTALLER" ; tput sgr0
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
echo -e ""
echo -e "      This script will do the installation"
echo -e "   manager for SlowDNS connection mode."
echo -e ""
echo -e "         \033[1;33mInstaller made by inc🦜 \033[1;37m"
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
echo ""
echo -e "DOWLOADING DEPENDENCIES..."
echo ""
fun_att () {
apt update -y
apt install ncurses-bin -y
mkdir -p /etc/slowdns
cd /etc/slowdns
wget https://github.com/mamba07k/slow-dns/raw/main/dns-server; chmod +x dns-server
wget https://raw.githubusercontent.com/mamba07k/slow-dns/main/remove-slow; chmod +x remove-slow
wget https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-info; chmod +x slowdns-info
wget https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-drop; chmod +x slowdns-drop
wget https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-ssh; chmod +x slowdns-ssh
wget https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-ssl; chmod +x slowdns-ssl
wget https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-socks; chmod +x slowdns-socks
wget https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns; chmod +x slowdns; cp slowdns /bin/
wget https://raw.githubusercontent.com/mamba07k/slow-dns/main/stopdns; chmod +x stopdns
}
fun_bar 'fun_att'
echo -e "CONFIGURING FIREWALL..."
echo ""
fun_ports () {
# Ubuntu 22.04+ cloud images often ship with ufw active by default.
# Running ufw and firewalld side by side causes rule conflicts, so
# disable ufw first if it's present/enabled before firewalld takes over.
if command -v ufw > /dev/null 2>&1; then
    sudo ufw disable > /dev/null 2>&1
fi
apt install firewalld -y && sudo systemctl enable firewalld && sudo systemctl start firewalld && sudo firewall-cmd --zone=public --permanent --add-port=80/tcp && sudo firewall-cmd --zone=public --permanent --add-port=8080/tcp && sudo firewall-cmd --zone=public --permanent --add-port=443/tcp && sudo firewall-cmd && sudo firewall-cmd --zone=public --permanent --add-port=53/udp && sudo firewall-cmd --zone=public --permanent --add-port=5300/udp && sudo firewall-cmd && sudo firewall-cmd --zone=public --permanent --add-port=2222/tcp && sudo firewall-cmd --reload
}
fun_bar 'fun_ports'
echo -e "SETTING CLOUDFLARE DNS..."
echo ""
fun_dnscf () {
sudo systemctl disable systemd-resolved.service && sudo systemctl stop systemd-resolved.service && sudo mv /etc/resolv.conf /etc/resolv.conf.bkp && echo "nameserver 1.1.1.1" > /etc/resolv.conf
sudo systemctl enable systemd-resolved.service && sudo systemctl start systemd-resolved.service
sleep 2
}
fun_bar 'fun_dnscf'
clear
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "SLOWDNS MANAGER INSTALLER" ; tput sgr0
echo -e "\033[1;31m════════════════════════════════════════════════════\033[0m"
echo ""
echo -e "          \033[1;33mINSTALLATION COMPLETED!\033[0m          "
echo ""
echo -e "To open the menu, use the command: \033[1;33mslowdns\033[0m"
cd
rm install