#!/bin/bash

# ============================================================================

# SLOWDNS MANAGER INSTALLER

# Supported OS: Ubuntu 22.04

# ============================================================================

clear
set -o pipefail

# ============================================================================

# COLORS

# ============================================================================

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
NC='\033[0m'

# ============================================================================

# ROOT CHECK

# ============================================================================

if [[ $EUID -ne 0 ]]; then
echo -e "${RED}[ERROR] Please run this script as root.${NC}"
exit 1
fi

# ============================================================================

# OS CHECK

# ============================================================================

check_os() {

```
if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    OS_ID="$ID"
    OS_VER="$VERSION_ID"
else
    echo -e "${RED}[ERROR] Cannot detect operating system.${NC}"
    exit 1
fi

if [[ "$OS_ID" != "ubuntu" ]]; then
    echo -e "${RED}[ERROR] This installer supports Ubuntu only.${NC}"
    echo -e "Detected: $OS_ID $OS_VER"
    exit 1
fi

case "$OS_VER" in
    22.04)
        echo -e "${GREEN}[✓] Ubuntu 22.04 detected - supported.${NC}"
        ;;
    *)
        echo -e "${YELLOW}[WARNING] Ubuntu $OS_VER detected.${NC}"
        echo -e "${YELLOW}[WARNING] This installer is designed for Ubuntu 22.04.${NC}"
        sleep 2
        ;;
esac
```

}

# ============================================================================

# PROGRESS BAR FUNCTION

# ============================================================================

fun_bar() {

```
local command="$1"
local logfile="/tmp/slowdns-install.log"

rm -f "$logfile"

(
    eval "$command" > "$logfile" 2>&1
) &

local pid=$!

tput civis 2>/dev/null || true

echo -ne "  ${YELLOW}WAIT ${WHITE}- ${YELLOW}["

while kill -0 "$pid" 2>/dev/null; do
    echo -ne "${RED}#"
    sleep 0.2
done

wait "$pid"
local status=$?

echo -e "${YELLOW}]${NC}"

tput cnorm 2>/dev/null || true

if [[ $status -eq 0 ]]; then
    echo -e "  ${GREEN}[✓] OK!${NC}"
else
    echo -e "  ${RED}[✗] INSTALLATION FAILED!${NC}"
    echo -e "${YELLOW}Error log: $logfile${NC}"
    cat "$logfile"
    exit 1
fi
```

}

# ============================================================================

# NON-INTERACTIVE APT

# ============================================================================

export DEBIAN_FRONTEND=noninteractive

check_os

clear

echo -e "${RED}════════════════════════════════════════════════════${NC}"
tput setaf 7 2>/dev/null || true
tput setab 4 2>/dev/null || true
tput bold 2>/dev/null || true
printf '%40s\n' "SLOWDNS MANAGER INSTALLER"
tput sgr0 2>/dev/null || true
echo -e "${RED}════════════════════════════════════════════════════${NC}"

echo ""
echo "      This script will install the"
echo "   SlowDNS connection manager."
echo ""
echo -e "         ${YELLOW}Installer made by inc${NC}"
echo ""
echo -e "${RED}════════════════════════════════════════════════════${NC}"

# ============================================================================

# DOWNLOAD DEPENDENCIES AND SLOWDNS FILES

# ============================================================================

echo ""
echo -e "${YELLOW}DOWNLOADING DEPENDENCIES...${NC}"
echo ""

fun_att() {

```
apt-get update -y

apt-get install -y \
    wget \
    curl \
    ca-certificates \
    ncurses-bin \
    firewalld

mkdir -p /etc/slowdns

cd /etc/slowdns || exit 1

wget -q -O dns-server \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/dns-server

wget -q -O remove-slow \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/remove-slow

wget -q -O slowdns-info \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-info

wget -q -O slowdns-drop \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-drop

wget -q -O slowdns-ssh \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-ssh

wget -q -O slowdns-ssl \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-ssl

wget -q -O slowdns-socks \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns-socks

wget -q -O slowdns \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/slowdns

wget -q -O stopdns \
    https://raw.githubusercontent.com/mamba07k/slow-dns/main/stopdns

# Verify downloads
for file in \
    dns-server \
    remove-slow \
    slowdns-info \
    slowdns-drop \
    slowdns-ssh \
    slowdns-ssl \
    slowdns-socks \
    slowdns \
    stopdns
do
    if [[ ! -s "$file" ]]; then
        echo "Failed to download: $file"
        exit 1
    fi

    chmod +x "$file"
done

# Install global slowdns command
cp -f slowdns /usr/local/bin/slowdns
chmod +x /usr/local/bin/slowdns
```

}

fun_bar "fun_att"

# ============================================================================

# FIREWALL CONFIGURATION

# ============================================================================

echo ""
echo -e "${YELLOW}CONFIGURING FIREWALL...${NC}"
echo ""

fun_ports() {

```
# Disable UFW if installed to prevent firewall conflicts
if command -v ufw >/dev/null 2>&1; then
    ufw disable >/dev/null 2>&1 || true
fi

systemctl enable firewalld
systemctl restart firewalld

# TCP Ports
firewall-cmd --permanent --zone=public --add-port=80/tcp
firewall-cmd --permanent --zone=public --add-port=443/tcp
firewall-cmd --permanent --zone=public --add-port=8080/tcp
firewall-cmd --permanent --zone=public --add-port=2222/tcp

# UDP Ports
firewall-cmd --permanent --zone=public --add-port=53/udp
firewall-cmd --permanent --zone=public --add-port=5300/udp

firewall-cmd --reload
```

}

fun_bar "fun_ports"

# ============================================================================

# DNS CONFIGURATION - UBUNTU 22.04

# ============================================================================

echo ""
echo -e "${YELLOW}CONFIGURING DNS...${NC}"
echo ""

fun_dns() {

```
# Backup old resolv.conf only if it is a normal file
if [[ -f /etc/resolv.conf && ! -L /etc/resolv.conf ]]; then
    cp -f /etc/resolv.conf /etc/resolv.conf.bkp
fi

# Ensure systemd-resolved is enabled
systemctl enable systemd-resolved.service
systemctl start systemd-resolved.service

# Create DNS configuration directory
mkdir -p /etc/systemd/resolved.conf.d

# Configure Cloudflare DNS
cat > /etc/systemd/resolved.conf.d/slowdns.conf << EOF
```

[Resolve]
DNS=1.1.1.1 1.0.0.1
FallbackDNS=8.8.8.8 8.8.4.4
EOF

```
systemctl restart systemd-resolved.service
```

}

fun_bar "fun_dns"

# ============================================================================

# FINAL CHECK

# ============================================================================

if [[ ! -f /usr/local/bin/slowdns ]]; then
echo -e "${RED}SlowDNS installation failed.${NC}"
exit 1
fi

clear

echo -e "${RED}════════════════════════════════════════════════════${NC}"
tput setaf 7 2>/dev/null || true
tput setab 4 2>/dev/null || true
tput bold 2>/dev/null || true
printf '%40s\n' "SLOWDNS MANAGER INSTALLER"
tput sgr0 2>/dev/null || true
echo -e "${RED}════════════════════════════════════════════════════${NC}"

echo ""
echo -e "          ${GREEN}INSTALLATION COMPLETED!${NC}"
echo ""
echo -e "To open the SlowDNS menu, use:"
echo ""
echo -e "              ${YELLOW}slowdns${NC}"
echo ""

# Remove installer after completion

rm -f "$0"

exit 0
